<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
  <ui:VisualElement name="detail-root" class="hmi-root">
    <ui:VisualElement class="hmi-header"><ui:Label name="machine-name" text="Former" class="hmi-title"/><ui:Label name="machine-state" text="Fault" class="alert"/></ui:VisualElement>
    <ui:VisualElement class="metric-grid">
      <ui:VisualElement class="metric-card fault"><ui:Label text="temperatur" class="metric-label"/><ui:Label name="temperature-value" text="61.2 °C" class="metric-value"/></ui:VisualElement>
      <ui:VisualElement class="metric-card"><ui:Label text="füllstand" class="metric-label"/><ui:Label name="fill-value" text="68 %" class="metric-value"/></ui:VisualElement>
      <ui:VisualElement class="metric-card"><ui:Label text="zykluszeit" class="metric-label"/><ui:Label name="cycle-value" text="4.8 s" class="metric-value"/></ui:VisualElement>
      <ui:VisualElement class="metric-card"><ui:Label text="sollwert" class="metric-label"/><ui:Label name="setpoint-value" text="28cm/3mm" class="metric-value"/></ui:VisualElement>
    </ui:VisualElement>
    <ui:Label text="BEDIENUNG" class="hmi-section-label"/>
    <ui:VisualElement class="button-row"><ui:Button text="Start" class="hmi-button"/><ui:Button text="Stop" class="hmi-button"/><ui:Button text="Fehler quitt." class="hmi-button danger"/></ui:VisualElement>
    <ui:VisualElement class="button-row"><ui:Button text="Wartung" class="hmi-button"/><ui:Button text="Reset" class="hmi-button"/></ui:VisualElement>
    <ui:Label name="detail-fault" text="Formsensor außerhalb Toleranz" class="alert"/>
  </ui:VisualElement>
</ui:UXML>
