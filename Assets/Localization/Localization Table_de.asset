  - m_Id: 5442882287120461
    m_Localized: Falsches Produkt
    m_Metadata:
      m_Items: []
  - m_Id: 5442882287120462
    m_Localized: "F\xFCllstand niedrig"
    m_Metadata:
      m_Items: []
  - m_Id: 5442882287120463
    m_Localized: Saucentank leer
    m_Metadata:
      m_Items: []
  - m_Id: 5442882287120464
    m_Localized: "Saucentank an der Dosierstation auff\xFCllen (Nachf\xFCllknopf),
      quittieren, Wartung abschlie\xDFen, starten."
    m_Metadata:
      m_Items: []
  - m_Id: 5442882287120465
    m_Localized: "Belagbeh\xE4lter leer"
    m_Metadata:
      m_Items: []
  - m_Id: 5442882287120466
    m_Localized: "Belagbeh\xE4lter an der Dosierstation auff\xFCllen (Nachf\xFCllknopf),
      quittieren, Wartung abschlie\xDFen, starten."
    m_Metadata:
      m_Items: []
  - m_Id: 5442882287120467
    m_Localized: Pressen-Puffer voll
    m_Metadata:
      m_Items: []
  - m_Id: 5442882287120468
    m_Localized: "Presse pr\xFCfen (l\xE4uft sie? Zykluszeit zu lang?). Dann Pufferband
      quittieren und neu starten."
    m_Metadata:
      m_Items: []
  - m_Id: 5442882287120469
    m_Localized: Stau auf dem Band
    m_Metadata:
      m_Items: []
  - m_Id: 5442882287120470
    m_Localized: "Festsitzendes Produkt vom Band entfernen, quittieren, Wartung abschlie\xDFen,
      Band starten."
    m_Metadata:
      m_Items: []
  - m_Id: 5442882287120471
    m_Localized: "Temperatur au\xDFerhalb des Bereichs"
    m_Metadata:
      m_Items: []
  - m_Id: 5442882287120472
    m_Localized: "Heizung/K\xFChlaggregat defekt. Quittieren, Wartung abschlie\xDFen
      (repariert das Aggregat), starten und auf Temperatur warten."
    m_Metadata:
      m_Items: []
  - m_Id: 5442882287120473
    m_Localized: Solltemperatur nicht erreicht
    m_Metadata:
      m_Items: []
  - m_Id: 5442882287120474
    m_Localized: "Temperatur-Sollwert pr\xFCfen. Quittieren, Wartung abschlie\xDFen,
      erneut starten."
    m_Metadata:
      m_Items: []
  - m_Id: 5442882295508992
    m_Localized: Falsches Produkt in der Presse
    m_Metadata:
      m_Items: []
  - m_Id: 5442882295508993
    m_Localized: "Das Produkt ist als Ausschuss markiert und wird ignoriert. Quittieren,
      Wartung abschlie\xDFen, starten."
    m_Metadata:
      m_Items: []
  - m_Id: 5442882295508994
    m_Localized: "Bandst\xF6rung der Station"
    m_Metadata:
      m_Items: []
  - m_Id: 5442882295508995
    m_Localized: "Zuerst die Bandst\xF6rung beheben (siehe Band-Alarm), dann die
      Station quittieren."
