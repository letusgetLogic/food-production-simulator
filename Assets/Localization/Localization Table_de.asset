    m_Metadata:
      m_Items: []
  - m_Id: 5442882299703336
    m_Localized: "Lift f\xE4hrt herunter"
    m_Metadata:
      m_Items: []
  - m_Id: 5442882299703337
    m_Localized: "Nicht genug Teig f\xFCr eine Portion"
    m_Metadata:
      m_Items: []
  - m_Id: 5442882299703338
    m_Localized: Trichter wird geleert
    m_Metadata:
      m_Items: []
