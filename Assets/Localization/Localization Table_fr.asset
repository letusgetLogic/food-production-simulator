    m_Metadata:
      m_Items: []
  - m_Id: 5442882287120470
    m_Localized: "Retirer le produit coinc\xE9 du convoyeur, acquitter, terminer
      la maintenance, d\xE9marrer le convoyeur."
    m_Metadata:
      m_Items: []
  - m_Id: 5442882287120471
