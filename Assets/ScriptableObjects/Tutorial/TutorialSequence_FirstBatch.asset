%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d3a12e79c421ee0458709f440466e8bc, type: 3}
  m_Name: TutorialSequence_FirstBatch
  m_EditorClassIdentifier: Game.HMI::Game.HMI.SO_TutorialSequence
  _steps:
  - TitleKey: tutorial.welcome.title
    TitleFallback: Welcome to the line
    TextKey: tutorial.welcome.text
    TextFallback: Today you run a frozen pizza line - from the dough mixer to the
      packed pizza. Walk with W A S D and look around with the mouse.
    Condition: 1
    Amount: 2
  - TitleKey: tutorial.recipe.title
    TitleFallback: Read the recipe
    TextKey: tutorial.recipe.text
    TextFallback: Aim at the recipe terminal and press {0} - or switch to "Recipe"
      on any terminal. It lists the Margherita values every machine needs. Close
      it with Q.
    Condition: 12
    Amount: 0
  - TitleKey: tutorial.mixer_start.title
    TitleFallback: "Start the dough mixer"
    TextKey: tutorial.mixer_start.text
    TextFallback: "Go to a dough mixer and start it: start button (I) on the mixer's control panel ({0})."
    Condition: 3
    Amount: 0
  - TitleKey: tutorial.mixer_wait.title
    TitleFallback: Mixing
    TextKey: tutorial.mixer_wait.text
    TextFallback: The mixer needs a moment. Make sure the pot stands under the drum
      - pick it up with {0}, put it down with {1}.
    Condition: 4
    Amount: 0
  - TitleKey: tutorial.mixer_tilt.title
    TitleFallback: Tilt the drum
    TextKey: tutorial.mixer_tilt.text
    TextFallback: Mixing is done. Press the tilt button on the mixer with {0} - the
      dough ball drops into the pot.
    Condition: 5
    Amount: 0
  - TitleKey: tutorial.pot_carry.title
    TitleFallback: Pick up the pot
    TextKey: tutorial.pot_carry.text
    TextFallback: Aim at the pot with the dough and pick it up with {0}.
    Condition: 6
    Amount: 0
  - TitleKey: tutorial.pot_lift.title
    TitleFallback: Load the portioner
    TextKey: tutorial.pot_lift.text
    TextFallback: Carry the pot to the portioner and put it down on the lift with
      {1}.
    Condition: 7
    Amount: 0
  - TitleKey: tutorial.lift_up.title
    TitleFallback: "Raise the lift"
    TextKey: tutorial.lift_up.text
    TextFallback: "Press the \"Raise lift\" button with {0}. The pot tips and the dough falls into the hopper."
    Condition: 8
    Amount: 0
  - TitleKey: tutorial.portion.title
    TitleFallback: Portioning
    TextKey: tutorial.portion.text
    TextFallback: The portioner cuts the dough into portions (target 250 g). If it
      is stopped, start it at its control panel (I).
    Condition: 9
    Amount: 0
  - TitleKey: tutorial.press.title
    TitleFallback: Forming
    TextKey: tutorial.press.text
    TextFallback: The portions wait in the buffer and run into the press, which forms
      the pizza base. Watch the first stroke.
    Condition: 10
    Amount: 0
  - TitleKey: tutorial.hmi.title
    TitleFallback: "Watch the line"
    TextKey: tutorial.hmi.text
    TextFallback: "Open a terminal with {0}: the line terminal (screen \"Line overview\") stands at the end of the line next to the packaging, on the right in the direction of flow - every machine also has its own. Green = running, amber = warning, red = fault."
    Condition: 2
    Amount: 0
  - TitleKey: tutorial.first_pizza.title
    TitleFallback: The first pizza
    TextKey: tutorial.first_pizza.text
    TextFallback: 'Follow your pizza: the oven pre-bakes the base, it cools down,
      then sauce and mozzarella, shock freezer, packaging. Quality is checked at
      the end of the line.'
    Condition: 11
    Amount: 0
  - TitleKey: tutorial.fault_alarm.title
    TitleFallback: "Fault!"
    TextKey: tutorial.fault_alarm.text
    TextFallback: "The dosing station reports a fault: the sauce reservoir is empty, station and belt stand still (red lamp). Open a terminal ({0}) - the fault is at the top of the overview with cause and remedy."
    Condition: 16
    Amount: 0
  - TitleKey: tutorial.fault_refill.title
    TitleFallback: "Refill the reservoir"
    TextKey: tutorial.fault_refill.text
    TextFallback: "Go to the dosing station and press the refill button on the sauce dispenser ({0}). With the reservoir full the fault is cleared."
    Condition: 17
    Amount: 0
  - TitleKey: tutorial.fault_restart.title
    TitleFallback: "Start the station"
    TextKey: tutorial.fault_restart.text
    TextFallback: "Press start (I) on the dosing station's control panel ({0}) - the line runs on."
    Condition: 18
    Amount: 0
  - TitleKey: tutorial.palletizer.title
    TitleFallback: 'Palletizing'
    TextKey: tutorial.palletizer.text
    TextFallback: 'Behind the line end, good cartons are stacked on the pallet - 48 per pallet. Without a pallet or with a full one the palletizer stops and the line backs up (amber warning).'
    Condition: 13
    Amount: 0
  - TitleKey: tutorial.pallet_jack.title
    TitleFallback: 'Take the pallet jack'
    TextKey: tutorial.pallet_jack.text
    TextFallback: 'Full pallets are moved with the pallet jack. Aim at its handle and grab it with {0}. Push it with W A S D - it follows your view.'
    Condition: 14
    Amount: 0
  - TitleKey: tutorial.pallet_forks.title
    TitleFallback: 'Raise the forks'
    TextKey: tutorial.pallet_forks.text
    TextFallback: 'Drive the forks under a pallet and press R to raise them. R again lowers them, {1} lets go of the handle.'
    Condition: 15
    Amount: 0
  - TitleKey: tutorial.pallet_swap.title
    TitleFallback: 'Change the pallet'
    TextKey: tutorial.pallet_swap.text
    TextFallback: 'When the pallet is full: take it to a marked storage place in the left corner, then take an empty pallet from a stack in the right corner ({0}) and put it on the palletizer ({1}).'
    Condition: 0
    Amount: 25
  - TitleKey: tutorial.done.title
    TitleFallback: "First batch done!"
    TextKey: tutorial.done.text
    TextFallback: "You know the whole line now. Faults are handled like in the drill: read the cause in the HMI, acknowledge, fix, complete maintenance, start. P opens the pause menu with controls, save and load."
    Condition: 0
    Amount: 0
